# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (pooled recommended for serverless)
DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Email (Gmail SMTP via App Password) ───────────────────────────────────────
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── AI (Anthropic) ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Application ───────────────────────────────────────────────────────────────
PUBLIC_APP_URL=https://your-domain.com
ADMIN_EMAIL=owner@yourdomain.com
EMAIL_FROM="Picture Perfect TV Install <noreply@yourdomain.com>"
PORT=5000

# Server-side admin API secret. Never prefix secrets with VITE_ because Vite
# exposes VITE_* values to browser bundles.
ADMIN_API_TOKEN=replace-with-a-long-random-secret

# ── Client-side public configuration ───────────────────────────────────────────
# Google Analytics 4 Measurement ID (optional — analytics disabled if unset)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── SMS / Twilio (optional — SMS disabled if unset) ───────────────────────────
SMS_ENABLED=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+14045551234
TWILIO_MESSAGING_SERVICE_SID=

# ── Private customer media ────────────────────────────────────────────────────
# Production defaults disabled. See docs/MEDIA_STORAGE.md before enabling.
# Dev may use disk/memory. Use s3 or r2 for durable private object storage.
MEDIA_STORAGE=disabled
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_SESSION_TOKEN=
MEDIA_S3_PREFIX=pptv-media
MEDIA_S3_FORCE_PATH_STYLE=false
# Only for a verified persistent disk mount; never ordinary ephemeral .media.
MEDIA_DIR=
MEDIA_DISK_PERSISTENT=false
# Local OCR uses bundled English data for screenshot/label/receipt/note hints.
# Set false to disable OCR on a constrained instance; text/manual intake still works.
OCR_ENABLED=true
